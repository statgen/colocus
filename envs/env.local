# General settings
USE_DOCKER="yes"

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=<your secret key>
DJANGO_ADMIN_URL=<your admin url/>
DJANGO_DEBUG=True

# Postgres settings
POSTGRES_PASSWORD=<your postgress password>

# Database URLs
# core: this database stores only the metadata collected from scanning the input data; it is not stateful in the sense
# that it is never changed by user interaction and only changes when the underlying data changes
# django: this database stores state; user accounts, link hashes, etc.
DJANGO_DB_CORE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:{$POSTGRES_PORT}/${POSTGRES_DB_CORE}"
DJANGO_DB_DEFAULT_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:{$POSTGRES_PORT}/${POSTGRES_DB_DJANGO}"

