# General settings
USE_DOCKER="yes"
DJANGO_READ_DOT_ENV_FILE=True
DATA_PATH="/path/to/your/data"

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_MEDIA_ROOT=colocus/media
DJANGO_SECRET_KEY=<your secret key>
DJANGO_ADMIN_URL=<your admin url/>
DJANGO_DEBUG=True

# Postgres settings
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_DB_CORE="core"
POSTGRES_DB_DEFAULT="django"
POSTGRES_USER="colocus"
POSTGRES_PASSWORD=<your postgress password>

# Redis settings
REDIS_PORT=6479

# Uvicorn
# Set host to 0.0.0.0 if using docker/compose, otherwise 127.0.0.1
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8800
WEB_CONCURRENCY=1

# UI settings
UI_PORT=8100
UI_HOST="ui"

# For UI development
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_API_URL=http://django:${UVICORN_PORT}