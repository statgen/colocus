# General settings
USE_DOCKER="yes"
DJANGO_READ_DOT_ENV_FILE=True
DATA_PATH="./colocus/tests/data"

# Django settings
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_MEDIA_ROOT=colocus/media
DJANGO_SECRET_KEY=1234

# Postgres
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_DB_CORE="core"
POSTGRES_DB_DEFAULT="django"
POSTGRES_USER="colocus"
POSTGRES_PASSWORD="colocus"

# Uvicorn (must be 0.0.0.0 if running inside docker)
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8989
WEB_CONCURRENCY=1
