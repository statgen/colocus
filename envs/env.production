# General settings
USE_DOCKER="yes"

# Django settings
DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<your secret key>
DJANGO_ADMIN_URL=<your admin url/>
DJANGO_ALLOWED_HOSTS=<.your.domain.com>
DJANGO_DEBUG=False

# Postgres
POSTGRES_HOST="db"
POSTGRES_PORT="5432"
POSTGRES_DB_CORE="core"
POSTGRES_DB_DEFAULT="django"
POSTGRES_USER="colocus"
POSTGRES_PASSWORD=<your postgress password>

# Security
DJANGO_SECURE_SSL_REDIRECT=False

# Email
DJANGO_SERVER_EMAIL=

# Uvicorn
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8800
WEB_CONCURRENCY=2

# UI settings
UI_PORT=8100
UI_HOST="ui"

# Sentry
SENTRY_DSN=